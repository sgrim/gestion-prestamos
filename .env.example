# Copia este archivo a .env y ajusta los valores. .env no se versiona.

# Base de datos
POSTGRES_DB=prestamos
POSTGRES_USER=prestamos
POSTGRES_PASSWORD=cambia-esta-clave

# Seguridad JWT (mínimo 32 caracteres). Genera una con: openssl rand -base64 48
APP_JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio-123456
APP_JWT_EXPIRATION=2h

# Datos de demostración (usuario@test.com / admin@test.com). Pon false para no crearlos.
APP_SEED_ENABLED=true
APP_SEED_PASSWORD=123

# Puertos publicados en tu máquina
FRONTEND_PORT=4200
BACKEND_PORT=8081
DB_PORT=5433
